# Copy to .env and fill in your values
# cp .env.example .env

# IMPORTANT: do NOT set ANTHROPIC_API_KEY. The server authenticates through the
# logged-in `claude` CLI (subscription). Setting it switches to billed API credits.

# Optional (enables spoken TTS replies)
OPENAI_API_KEY=sk-...

# Your server's Tailscale/local IP (used by the Android app)
SERVER_IP=your-server-ip
